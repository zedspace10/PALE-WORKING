{
  "expo": {
    "name": "PALE",
    "slug": "pale",
    "scheme": "pale",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "extra": {
      "router": {
        "origin": "https://pale.space/"
      },
      "eas": {
        "projectId": "99b48305-73b0-4be6-8d07-91537694e0e0"
      }
    },
    "owner": "zedbs-organization",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.stellara.pale",
      "buildNumber": "61",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "PALE uses your location to show you which stars are visible above you tonight, and to work out when it gets dark where you are.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.stellara.pale",
      "versionCode": 2,
      "backgroundColor": "#000000",
      "permissions": ["ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION"]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://pale.space/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "locationWhenInUsePermission": "PALE uses your location to show you which stars are visible above you tonight, and to work out when it gets dark where you are."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "PALE switches on your phone's torch to send your note out as real light. It never takes photos or video.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "newArchEnabled": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
